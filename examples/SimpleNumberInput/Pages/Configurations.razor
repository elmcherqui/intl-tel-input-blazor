@page "/configurations"
@using IntlTelInputBlazor

<h1>Configuration Options</h1>
<p>Each input below demonstrates a different combination of initialization parameters.</p>

<hr/>

@* --- 1. Separate Dial Code --- *@
<div class="demo-section">
    <h4>Separate Dial Code</h4>
    <p class="text-muted">Shows the dial code next to the flag, outside the input.</p>
    <code>SeparateDialCode="true" InitialCountry="gb"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val1"
                          InitialCountry="gb"
                          SeparateDialCode="true"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 2. National Mode Off (International Format) --- *@
<div class="demo-section">
    <h4>International Mode (NationalMode=false)</h4>
    <p class="text-muted">Numbers are displayed and formatted in international format with the dial code.</p>
    <code>NationalMode="false" InitialCountry="de" FormatOnDisplay="true"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val2"
                          InitialCountry="de"
                          NationalMode="false"
                          FormatOnDisplay="true"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 3. Strict Mode --- *@
<div class="demo-section">
    <h4>Strict Mode</h4>
    <p class="text-muted">Only allows a plus followed by numeric digits, capped at max valid length. Try typing letters.</p>
    <code>StrictMode="true" InitialCountry="us"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val3"
                          InitialCountry="us"
                          StrictMode="true"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 4. Country Order (Priority Countries) --- *@
<div class="demo-section">
    <h4>Country Order (Priority Countries)</h4>
    <p class="text-muted">Japan, South Korea, and Australia appear at the top of the dropdown.</p>
    <code>CountryOrder='new[] {"jp", "kr", "au"}' InitialCountry="jp"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val4"
                          InitialCountry="jp"
                          CountryOrder='new[] {"jp", "kr", "au"}'/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 5. Only Countries (Restricted List) --- *@
<div class="demo-section">
    <h4>Only Countries (Restricted List)</h4>
    <p class="text-muted">Dropdown only contains US, Canada, Mexico, and UK.</p>
    <code>OnlyCountries='new[] {"us", "ca", "mx", "gb"}'</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val5"
                          InitialCountry="us"
                          OnlyCountries='new[] {"us", "ca", "mx", "gb"}'/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 6. Exclude Countries --- *@
<div class="demo-section">
    <h4>Exclude Countries</h4>
    <p class="text-muted">All countries except Russia and North Korea.</p>
    <code>ExcludeCountries='new[] {"ru", "kp"}'</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val6"
                          InitialCountry="us"
                          ExcludeCountries='new[] {"ru", "kp"}'/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 7. Dropdown Disabled (No Dropdown) --- *@
<div class="demo-section">
    <h4>Dropdown Disabled</h4>
    <p class="text-muted">Country is fixed to France &mdash; no dropdown arrow, not clickable.</p>
    <code>AllowDropdown="false" InitialCountry="fr"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val7"
                          InitialCountry="fr"
                          AllowDropdown="false"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 8. No Flags --- *@
<div class="demo-section">
    <h4>No Flags</h4>
    <p class="text-muted">Hides country flags entirely. Shows a globe icon instead.</p>
    <code>ShowFlags="false" SeparateDialCode="true"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val8"
                          InitialCountry="us"
                          ShowFlags="false"
                          SeparateDialCode="true"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 9. No Country Search --- *@
<div class="demo-section">
    <h4>No Country Search</h4>
    <p class="text-muted">Disables the search input at the top of the country dropdown.</p>
    <code>CountrySearch="false"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val9"
                          InitialCountry="us"
                          CountrySearch="false"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 10. Fixed-Line Placeholder --- *@
<div class="demo-section">
    <h4>Fixed-Line Placeholder</h4>
    <p class="text-muted">Placeholder shows a fixed-line number example instead of mobile.</p>
    <code>PlaceholderNumberType="FIXED_LINE" AutoPlaceholder="aggressive"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val10"
                          InitialCountry="gb"
                          PlaceholderNumberType="FIXED_LINE"
                          AutoPlaceholder="aggressive"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 11. Placeholder Off --- *@
<div class="demo-section">
    <h4>Placeholder Off</h4>
    <p class="text-muted">No automatic placeholder is set.</p>
    <code>AutoPlaceholder="off"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val11"
                          InitialCountry="us"
                          AutoPlaceholder="off"
                          placeholder="Enter your number"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 12. Format As You Type Disabled --- *@
<div class="demo-section">
    <h4>Format As You Type Disabled</h4>
    <p class="text-muted">No automatic formatting while typing. Compare with the next input (formatting enabled).</p>
    <div class="row">
        <div class="col-md-6">
            <code>FormatAsYouType="false"</code>
            <EditForm EditContext="_ctx">
                <IntlTelInput @bind-Value="_val12a"
                              InitialCountry="us"
                              FormatAsYouType="false"/>
            </EditForm>
        </div>
        <div class="col-md-6">
            <code>FormatAsYouType="true" (default)</code>
            <EditForm EditContext="_ctx">
                <IntlTelInput @bind-Value="_val12b"
                              InitialCountry="us"
                              FormatAsYouType="true"/>
            </EditForm>
        </div>
    </div>
</div>

<hr/>

@* --- 13. Fixed Dropdown Width Off --- *@
<div class="demo-section">
    <h4>Dropdown Width (Fixed vs Auto)</h4>
    <p class="text-muted">Left: dropdown matches input width. Right: dropdown auto-sizes to content.</p>
    <div class="row">
        <div class="col-md-6">
            <code>FixDropdownWidth="true" (default)</code>
            <EditForm EditContext="_ctx">
                <IntlTelInput @bind-Value="_val13a"
                              InitialCountry="us"
                              FixDropdownWidth="true"/>
            </EditForm>
        </div>
        <div class="col-md-6">
            <code>FixDropdownWidth="false"</code>
            <EditForm EditContext="_ctx">
                <IntlTelInput @bind-Value="_val13b"
                              InitialCountry="us"
                              FixDropdownWidth="false"/>
            </EditForm>
        </div>
    </div>
</div>

<hr/>

@* --- 14. Custom Container Class --- *@
<div class="demo-section">
    <h4>Custom Container Class</h4>
    <p class="text-muted">Adds a custom CSS class to the outer container for styling.</p>
    <code>ContainerClass="custom-phone-container"</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @bind-Value="_val14"
                          InitialCountry="us"
                          ContainerClass="custom-phone-container"/>
        </EditForm>
    </div>
</div>

<hr/>

@* --- 15. Mobile-Only Validation --- *@
<div class="demo-section">
    <h4>Mobile-Only Validation</h4>
    <p class="text-muted">Only mobile numbers are considered valid.</p>
    <code>AllowedNumberTypes='new[] {"MOBILE"}'</code>
    <div class="mt-2">
        <EditForm EditContext="_ctx">
            <IntlTelInput @ref="_mobileOnly"
                          @bind-Value="_val15"
                          InitialCountry="us"
                          AllowedNumberTypes='new[] {"MOBILE"}'/>
        </EditForm>
        <button class="btn btn-sm btn-outline-primary mt-1" @onclick="CheckMobileOnly">Check Validity</button>
        @if (!string.IsNullOrEmpty(_mobileOnlyResult))
        {
            <span class="ms-2 text-muted">@_mobileOnlyResult</span>
        }
    </div>
</div>

@code {
    EditContext _ctx;

    IntlTel _val1, _val2, _val3, _val4, _val5, _val6, _val7, _val8, _val9;
    IntlTel _val10, _val11, _val12a, _val12b, _val13a, _val13b, _val14, _val15;

    IntlTelInput _mobileOnly;
    string _mobileOnlyResult;

    protected override void OnInitialized()
    {
        _ctx = new EditContext(new object());
    }

    private async Task CheckMobileOnly()
    {
        if (_mobileOnly is null) return;
        var valid = await _mobileOnly.IsValidNumber();
        var precise = await _mobileOnly.IsValidNumberPrecise();
        var error = await _mobileOnly.GetValidationError();
        _mobileOnlyResult = $"Valid: {valid} | Precise: {precise} | Error: {error}";
    }
}
